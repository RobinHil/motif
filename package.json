{
  "name": "motif",
  "productName": "Motif",
  "version": "0.1.0",
  "description": "Desktop music production app built on Strudel",
  "license": "AGPL-3.0-or-later",
  "author": "Motif contributors",
  "desktopName": "motif.desktop",
  "private": true,
  "main": "./out/main/index.js",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "licenses": "bun scripts/third-party-licenses.ts",
    "package": "electron-vite build && bun run licenses && electron-builder",
    "test:coverage": "vitest run --coverage",
    "samples:kit": "bun scripts/generate-kit.ts",
    "icons": "bun scripts/generate-icons.ts",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.3",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "acorn": "8.18.0",
    "immer": "11.1.18",
    "nanoid": "6.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "superdough": "1.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
